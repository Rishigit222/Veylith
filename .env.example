CHRONICLE_GUARD_LOG_LEVEL=INFO

# development or production. In production, demo reviewer auth is disabled
# unless VEYLITH_ALLOW_DEMO_AUTH=true is explicitly set for a private demo.
VEYLITH_ENV=development
VEYLITH_ALLOW_DEMO_AUTH=false
VEYLITH_CORS_ORIGINS=
HOST=0.0.0.0
PORT=8000
FORWARDED_ALLOW_IPS=*

# Safe demo-only reviewer credentials. Replace these values locally; they are
# read from the environment and are never stored in source or persisted.
CHRONICLE_DEMO_REVIEWER_EMAIL=reviewer@example.com
CHRONICLE_DEMO_REVIEWER_PASSWORD=change-me-demo-password

# SQLite path for durable repair-review decisions. The parent directory is
# created automatically. Use :memory: only for isolated tests.
VEYLITH_DATA_PATH=data/veylith.sqlite3

# Server-side Ring Partner API configuration. Never put the token in frontend
# code, mobile settings, or Git.
RING_ACCESS_TOKEN=replace-with-server-side-ring-access-token
RING_API_BASE_URL=https://api.amazonvision.com
