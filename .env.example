CHRONICLE_GUARD_LOG_LEVEL=INFO

# Safe demo-only reviewer credentials. Replace these values locally; they are
# read from the environment and are never stored in source or persisted.
CHRONICLE_DEMO_REVIEWER_EMAIL=reviewer@example.com
CHRONICLE_DEMO_REVIEWER_PASSWORD=change-me-demo-password

# SQLite path for durable repair-review decisions. The parent directory is
# created automatically. Use :memory: only for isolated tests.
VEYLITH_DATA_PATH=data/veylith.sqlite3
